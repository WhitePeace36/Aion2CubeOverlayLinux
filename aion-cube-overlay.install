# Lets the overlay read the game's traffic without running as root (pacman does not keep file capabilities in
# the package, so they are set here, like wireshark does for dumpcap).
_caps() {
  if command -v setcap >/dev/null 2>&1; then
    setcap cap_net_raw,cap_net_admin=eip usr/bin/aion-cube-overlay
  else
    echo ">>> setcap not found: run  sudo setcap cap_net_raw,cap_net_admin=eip /usr/bin/aion-cube-overlay"
  fi
}

post_install() {
  _caps
  echo ">>> Start it with: aion-cube-overlay   (aion-cube-overlay --demo to try it without the game)"
}

post_upgrade() {
  _caps
}
