# Maintainer: timon <timon2201@gmail.com>
#
# Builds aion-cube-overlay from a git repository. By default that is the repository this PKGBUILD sits in
# (packaging/arch/ inside it), so `makepkg -si` here packages your latest commit. Only committed changes are
# built. To build from somewhere else, for example a GitHub copy:
#   AION_CUBE_OVERLAY_REPO=https://github.com/<you>/Aion2CubeOverlayLinux.git makepkg -si

pkgname=aion-cube-overlay-git
_name=aion-cube-overlay
pkgver=.r1.gfb0180c
pkgrel=1
pkgdesc='Aion 2 Hidden Cube radar with height above or below you, as a click-through Wayland overlay'
arch=('x86_64' 'aarch64')
license=('GPL-3.0-or-later')
depends=('libpcap' 'libcap' 'gcc-libs' 'glibc')
makedepends=('cargo' 'git')
optdepends=(
  'fontconfig: find a system font for the text (fc-match)'
  'noto-fonts: a font for the text, if none is installed'
  'pipewire: sounds with --alert-cmd "pw-play ..."'
  'libnotify: notifications with --alert-cmd "notify-send ..."'
)
provides=("$_name")
conflicts=("$_name")
install="$_name.install"
_repo="${AION_CUBE_OVERLAY_REPO:-$(realpath "$startdir/../..")}"
case "$_repo" in
  *://*) source=("$_name::git+$_repo") ;;
  *) source=("$_name::git+file://$_repo") ;;
esac
sha256sums=('SKIP')

pkgver() {
  cd "$_name"
  local version
  version=$(sed -n 's/^version = "\(.*\)"/\1/p' Cargo.toml | head -n1)
  printf '%s.r%s.g%s' "$version" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

check() {
  cd "$_name"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo test --frozen --workspace
}

package() {
  cd "$_name"
  install -Dm755 "target/release/$_name" "$pkgdir/usr/bin/$_name"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$_name/README.md"
  install -Dm644 docs/preview.png "$pkgdir/usr/share/doc/$_name/preview.png"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
